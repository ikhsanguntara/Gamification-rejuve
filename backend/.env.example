# ==============================================================================
# RE.JUVE GAMIFICATION — BACKEND REST API ENVIRONMENT VARIABLES (.env)
# ==============================================================================

# Port & Node Environment
PORT=3000
NODE_ENV=development

# Database Target: PostgreSQL
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/db_gamification?schema=public"

# JWT Authentication Secret & Token Expiry
JWT_SECRET="rejuve_super_secret_jwt_key_2026_gamification_api"
JWT_EXPIRES_IN="7d"

# CORS Configuration (Domain frontend yang diizinkan)
# Pisahkan dengan koma jika multi-domain atau gunakan '*' untuk mengizinkan semua.
CORS_ORIGIN="*"

# MinIO S3 Object Storage (Penyimpanan Foto Bukti Evaluasi Misi)
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="gamification"
MINIO_PUBLIC_URL="http://localhost:9000/gamification"

# Lynx ERP Re.juve External Integration (Sinkronisasi Gerai & Karyawan)
LYNX_API_URL="https://lynx-api.rejuve.co.id/api/v1"
LYNX_API_TOKEN="lynx_integration_token_placeholder"
