            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Batch 4 - Senayan City\",\n  \"storeId\": \"store-002\",\n  \"templatePackageId\": \"pkg-std-01\",\n  \"buddyPackageId\": \"pkg-buddy-standard\",\n  \"startDate\": \"2026-09-10\",\n  \"totalWeeks\": 3,\n  \"approvalConfig\": {\n    \"minScoreFor5Stars\": 90,\n    \"minEvidenceCount\": 1,\n    \"requireEvidence\": true\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/batches",
              "host": ["{{base_url}}"],
              "path": ["batches"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Store Leader Evaluations",
      "item": [
        {
          "name": "Submit Mission Evaluation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"batchId\": \"batch-alpha\",\n  \"missionId\": \"msn-w2-001\",\n  \"crewId\": \"crew-001\",\n  \"slScore\": 95,\n  \"comment\": \"Pemeriksaan rasa jus cold-pressed sangat segar dan takaran brix presisi.\",\n  \"evidenceUrls\": [\n    {\n      \"url\": \"https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=600&q=80\",\n      \"caption\": \"Foto brix meter 12.4\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/evaluations",
              "host": ["{{base_url}}"],
              "path": ["evaluations"]
            }
          }
        }
      ]
    },
    {
      "name": "7. District Manager Approvals",
      "item": [
        {
          "name": "Get Pending Approvals",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/approvals?status=PENDING_REVIEW&storeId=store-001",
              "host": ["{{base_url}}"],
              "path": ["approvals"],
              "query": [
                { "key": "status", "value": "PENDING_REVIEW" },
                { "key": "storeId", "value": "store-001" }
              ]
            }
          }
        },
        {
          "name": "Approve Mission with DM Score Adjustment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dmScore\": 90,\n  \"dmNote\": \"Hasil kalibrasi sensorik konsisten baik.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/approvals/appr-001/approve",
              "host": ["{{base_url}}"],
              "path": ["approvals", "appr-001", "approve"]
            }
          }
        }
      ]
    },
    {
      "name": "8. Gamification & Progression",
      "item": [
        {
          "name": "Get Crew Journey Map",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/gamification/journey/crew-001",
              "host": ["{{base_url}}"],
              "path": ["gamification", "journey", "crew-001"]
            }
          }
        },
        {
          "name": "Get Store Leaderboard",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/gamification/leaderboard?storeId=store-001",
              "host": ["{{base_url}}"],
              "path": ["gamification", "leaderboard"],
              "query": [
                { "key": "storeId", "value": "store-001" }
              ]
            }
          }
        }
      ]
    },
    {
