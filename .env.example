# ==============================================================================
# RE.JUVE GAMIFICATION — UNIFIED ENVIRONMENT CONFIGURATION GUIDE
# ==============================================================================
# Project ini terbagi menjadi 2 bagian utama:
# 1. FRONTEND (Nuxt 3) -> Konfigurasi di: frontend/.env
# 2. BACKEND (Express.js + Prisma) -> Konfigurasi di: backend/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PENGATURAN FRONTEND (frontend/.env)
# ------------------------------------------------------------------------------
# Ganti URL ini untuk mengarahkan frontend ke server API yang diinginkan:
# - VPS Dev / Staging: http://103.168.147.133:3005/api
# - Local Backend    : http://localhost:3000/api
# - Production API   : https://api.gamification.rejuve.co.id/api
NUXT_PUBLIC_API_BASE=http://103.168.147.133:3005/api
NUXT_PUBLIC_APP_ENV=development
NUXT_PUBLIC_APP_NAME="Rejuve Gamification"
NUXT_PUBLIC_APP_VERSION="1.0.0"
NUXT_PUBLIC_API_TIMEOUT=30000

# ------------------------------------------------------------------------------
# 2. PENGATURAN BACKEND (backend/.env)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/db_gamification?schema=public"
JWT_SECRET="rejuve_super_secret_jwt_key_2026_gamification_api"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="*"
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="gamification"
LYNX_API_URL="https://lynx-api.rejuve.co.id/api/v1"
LYNX_API_TOKEN="lynx_integration_token_placeholder"
