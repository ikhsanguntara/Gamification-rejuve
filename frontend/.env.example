# ==============================================================================
# RE.JUVE GAMIFICATION — FRONTEND ENVIRONMENT VARIABLES (.env)
# ==============================================================================
# File ini digunakan oleh Nuxt 3 untuk konfigurasi runtime aplikasi.
# Ganti NUXT_PUBLIC_API_BASE saat berpindah antara Ngrok, Localhost, Staging, atau Production.
#
# CONTOH URL TARGET:
# - Ngrok Live Dev : https://cagelike-flukily-niels.ngrok-free.dev/api
# - Local Backend  : http://localhost:3000/api
# - Staging Server : https://staging-api.gamification.rejuve.co.id/api
# - Production API : https://api.gamification.rejuve.co.id/api
# ==============================================================================

# URL Basis REST API Backend
NUXT_PUBLIC_API_BASE=https://cagelike-flukily-niels.ngrok-free.dev/api

# Environment Mode: development | staging | production
NUXT_PUBLIC_APP_ENV=development

# Informasi Aplikasi
NUXT_PUBLIC_APP_NAME="Rejuve Gamification"
NUXT_PUBLIC_APP_VERSION="1.0.0"

# Request Timeout (dalam milidetik)
NUXT_PUBLIC_API_TIMEOUT=30000
